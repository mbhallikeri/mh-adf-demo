			"email_sub_var": {
				"type": "String"
			},
			"email_body_var": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-02T03:39:22Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
