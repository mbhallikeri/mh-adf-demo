						"value": "The ingestion process has been completed for all the tables listed below with their respective status.\n\n@{replace(string(pipeline().parameters.table_status),'\"','')}\nPipeline Run-ID : @{pipeline().RunId}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_recepient": {
				"type": "string"
			},
			"table_status": {
				"type": "array"
			}
		},
		"variables": {
			"logic_app_body_var": {
				"type": "String"
