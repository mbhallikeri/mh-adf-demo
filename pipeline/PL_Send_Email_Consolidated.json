					{
						"activity": "Set_Email_Sub",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_Email_Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_app_body_var",
					"value": {
						"value": "{\n  \"email_recepient\": \"@{pipeline().parameters.email_recepient}\",\n  \"email_subject\": \"@{variables('email_sub_var')}\",\n  \"email_body\": \"@{variables('email_body_var')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_Email_Sub",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_sub_var",
					"value": {
						"value": "Ingestion completed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_Email_Body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body_var",
