{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "demo-adf-mbhallikeriADF01"
		},
		"LS_SQL_SRVR_CONN_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_SRVR_CONN'"
		},
		"LS_ADF_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://mbhallikeriadf01sa.dfs.core.windows.net/"
		},
		"LS_SQL_SRVR_CONN_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adf-demo-sql-srv.database.windows.net"
		},
		"LS_SQL_SRVR_CONN_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "add-demo-sql-db"
		},
		"LS_SQL_SRVR_CONN_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "mbhallikeriadf01"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "demo-adf-mbhallikeriADF01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQL_SRVR_CONN_password": {
						"value": "[parameters('LS_SQL_SRVR_CONN_password')]"
					},
					"LS_ADF_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADF_ADLS_properties_typeProperties_url')]"
					},
					"LS_SQL_SRVR_CONN_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_SRVR_CONN_properties_typeProperties_server')]"
					},
					"LS_SQL_SRVR_CONN_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_SRVR_CONN_properties_typeProperties_database')]"
					},
					"LS_SQL_SRVR_CONN_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_SRVR_CONN_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}